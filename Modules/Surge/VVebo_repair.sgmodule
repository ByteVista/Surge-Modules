#!name=VVebo时间线修复
#!desc=修复失效的用户时间线和我的页面。使用此插件前需要禁用微博去广告插件，避免插件冲突导致失效。
#!author=suiyuran[https://github.com/suiyuran], androidcn[https://github.com/androidcn]
#!icon=icon not found
#!category=AdBlock
#!openUrl=https://apps.apple.com/app/id670910957
#!tag=功能增强
#!loon_version=3.4.0(962)
#!homepage=https://hub.kelee.one
#!date=2026-06-01 17:11:35

[Script]
修复时间线 = type=http-request, pattern=^https:\/\/api\.weibo\.cn\/2\/users\/show\?, script-path=https://bytevista.github.io/Surge-Modules/Modules/Surge/_resources/vvebo/kelee.one_VVebo_repair-8edf1c3fff61fc20.js

修复时间线 = type=http-request, pattern=^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?, script-path=https://bytevista.github.io/Surge-Modules/Modules/Surge/_resources/vvebo/kelee.one_VVebo_repair-8edf1c3fff61fc20.js

修复时间线 = type=http-request, pattern=^https:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?, script-path=https://bytevista.github.io/Surge-Modules/Modules/Surge/_resources/vvebo/kelee.one_VVebo_repair-8edf1c3fff61fc20.js

修复时间线 = type=http-response, pattern=^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?, script-path=https://bytevista.github.io/Surge-Modules/Modules/Surge/_resources/vvebo/kelee.one_VVebo_repair-8edf1c3fff61fc20.js, requires-body=true

修复我的页面 = type=http-response, pattern=^https:\/\/api\.weibo\.cn\/2\/cardlist\?, script-path=https://bytevista.github.io/Surge-Modules/Modules/Surge/_resources/vvebo/kelee.one_VVebo_repair-8edf1c3fff61fc20.js, requires-body=true

[MITM]
hostname = %APPEND% api.weibo.cn
